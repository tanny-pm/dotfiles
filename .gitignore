# ===== 秘密情報（防御的除外・絶対にコミットしない） =====
**/.credentials.json
**/hosts.yml
**/config.yml
# gh-dash の config.yml は秘密情報を含まないため管理対象
!gh-dash/.config/gh-dash/config.yml
*.token
*.pem
*.key
.env
.env.*

# ===== macOS =====
.DS_Store

# ===== Emacs のロック/自動保存/バックアップ（リポジトリ全体） =====
\#*\#
.\#*
*~

# ===== Claude Code の状態・履歴系（config系のみ管理） =====
claude/.claude/projects/
claude/.claude/sessions/
claude/.claude/session-env/
claude/.claude/history.jsonl
claude/.claude/file-history/
claude/.claude/shell-snapshots/
claude/.claude/backups/
claude/.claude/cache/
claude/.claude/daemon*
claude/.claude/jobs/
claude/.claude/plans/
claude/.claude/plugins/
claude/.claude/ide/
claude/.claude/debug/
claude/.claude/tasks/
claude/.claude/.last-cleanup

# ===== Zed の状態・バイナリDB =====
zed/.config/zed/prompts/
zed/.config/zed/conversations/
zed/.config/zed/*.log

# ===== herdr の状態・実行時ファイル（config.toml のみ管理） =====
herdr/.config/herdr/*.log
herdr/.config/herdr/*.sock
herdr/.config/herdr/*.bak.*
herdr/.config/herdr/session.json
herdr/.config/herdr/plugins.json
herdr/.config/herdr/plugins/

# ===== Ghostty の自動生成テーマ =====
ghostty/Library/Application Support/com.mitchellh.ghostty/auto/

# ===== Emacs の状態・実行時ファイル（init.el のみ管理） =====
emacs/.emacs.d/auto-save-list/
emacs/.emacs.d/eln-cache/
emacs/.emacs.d/elpa/
emacs/.emacs.d/backups/
emacs/.emacs.d/transient/
emacs/.emacs.d/*.elc
emacs/.emacs.d/recentf
emacs/.emacs.d/history
emacs/.emacs.d/places
emacs/.emacs.d/.saves-*
emacs/.emacs.d/#*#
emacs/.emacs.d/*~
