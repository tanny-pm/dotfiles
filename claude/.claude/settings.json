{
  "model": "opus",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash '/Users/celica/.claude/hooks/herdr-agent-state.sh' session",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "afplay /System/Library/Sounds/Ping.aiff",
            "async": true
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "sh /Users/celica/.claude/statusline-command.sh"
  },
  "theme": "auto",
  "preferredNotifChannel": "terminal_bell",
  "agentPushNotifEnabled": true,
  "enabledPlugins": {
    "claude-code-setup@claude-plugins-official": true
  }
}
