{
  "model": "opus",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "test -f \"$HOME/.claude/hooks/herdr-agent-state.sh\" && bash \"$HOME/.claude/hooks/herdr-agent-state.sh\" session || true",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "sh \"$HOME/.claude/statusline-command.sh\""
  },
  "enabledPlugins": {
    "claude-code-setup@claude-plugins-official": true,
    "rust-analyzer-lsp@claude-plugins-official": true
  },
  "theme": "auto",
  "agentPushNotifEnabled": true,
  "effortLevel": "medium"
}
